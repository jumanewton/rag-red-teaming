# ─── LLM Provider (choose one) ─────────────────────────────────────────────────
# Option A: Local Ollama (free, no API key — recommended for bulk red teaming)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=

# Option A2: Ollama Cloud (https://ollama.com) — use host only, not /api
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Option B: Gemini API (free tier available at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Active LLM backend: "ollama" or "gemini"
LLM_BACKEND=ollama

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_knowledge_base

# ─── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── RAG Retrieval ────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_MMR_FETCH_K=20
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Security ─────────────────────────────────────────────────────────────────
API_KEY=redteam-secret-key-change-in-prod
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ─── Observability ─────────────────────────────────────────────────────────────
PHOENIX_ENABLED=true
PHOENIX_PORT=6006

# ─── Red Team Settings ─────────────────────────────────────────────────────────
RAG_SERVICE_URL=http://localhost:8000
RED_TEAM_API_KEY=redteam-secret-key-change-in-prod
REPORTS_DIR=./red_team/reports
